<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget «Nächste Übungen» nach dem Entwurf «Android-Widget 2×4» (Tag; die Nacht folgt den Tokens): Karte mit Rand und 28 dp Radius,
    Kopfzeile mit Flamme, darunter zwei Übungen. Jede hat den Titel, darunter Einheit (Logo oder Kürzel), Tag und Beginn, «x von y»
    und je Person einen Chip mit Namen (bis zwei Personen) oder einen Kreis mit Initiale und Stand-Zeichen (ab drei). Nur Ansehen; ein
    Tipp öffnet die App. Alles, was RemoteViews kann: Layouts, TextView, ImageView. Die Texte setzt AppointmentWidget; bis dahin steht
    «Wird geladen …» da, nie Beispiele.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_flame" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 700"
            android:importantForAccessibility="no"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/widget_header"
            android:textAllCaps="true"
            android:textColor="@color/widget_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_row_ripple"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/row1_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 700"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row1_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="@drawable/widget_badge_tag"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 800"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:letterSpacing="0.04"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/widget_badge_fg"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/row1_logo"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxWidth="44dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/row1_when"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 700"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/row1_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 600"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/row1_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_row_ripple"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/row2_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 700"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row2_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="@drawable/widget_badge_tag"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 800"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:letterSpacing="0.04"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/widget_badge_fg"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/row2_logo"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxWidth="44dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/row2_when"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 700"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/widget_accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/row2_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 600"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/widget_text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/row2_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_row_ripple"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:text="@string/widget_no_more"
        android:textColor="@color/widget_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_row_ripple"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_text"
        android:textSize="15sp" />
</LinearLayout>
