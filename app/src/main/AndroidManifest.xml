<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ab Android 13 braucht die App die Erlaubnis, Mitteilungen zu zeigen; sie fragt einmal und sonst im Profil. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Damit die App prüfen kann, ob eine Telefon-App da ist (Android 11 und neuer): Der Knopf «Anrufen» fehlt sonst. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <!--
        Kein Backup: Sitzung und Daten dürfen das Gerät nie verlassen. Bis Android 11 sperrt allowBackup="false"
        alles (fullBackupContent wäre überflüssig), ab Android 12 gelten die dataExtractionRules.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules,UnusedAttribute"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CeviOS">
        <!-- Kein Token beim Start: Die App holt es erst nach dem Anmelden (PushToken) und schaltet dann die Erneuerung ein. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Kleines Symbol der Mitteilung, wenn das System sie zeigt: die weisse Silhouette des Cevi-Logos (Android färbt es selbst ein). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_logo" />
        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.CeviOS.Starting"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:windowSoftInputMode="adjustResize"> <!-- Compose rechnet die Tastatur selbst ein; ohne diese Angabe verschiebt das System das Fenster zusätzlich -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
